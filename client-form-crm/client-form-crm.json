        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Project Details Request</title>\n</head>\n\n<body style=\"margin:0; padding:0; background-color:#f8fafc; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color:#334155; -webkit-font-smoothing:antialiased;\">\n\n  <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#f8fafc; padding:40px 20px;\">\n    <tr>\n      <td align=\"center\">\n\n        <!-- Main Container -->\n        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:620px; background-color:#ffffff; border-radius:12px; overflow:hidden; border:1px solid #e2e8f0; box-shadow:0 8px 24px rgba(15,23,42,0.05);\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background-color:#0f172a; padding:28px 40px;\">\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                <tr>\n                  <td>\n                    <div style=\"font-size:11px; line-height:1.4; font-weight:700; letter-spacing:1.6px; color:#94a3b8; text-transform:uppercase; margin-bottom:7px;\">\n                      Action Required\n                    </div>\n\n                    <div style=\"font-size:19px; line-height:1.35; font-weight:700; letter-spacing:0.4px; color:#ffffff;\">\n                      HASHNAB AUTOMATION\n                    </div>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Accent Bar -->\n          <tr>\n            <td style=\"height:4px; background-color:#2563eb; font-size:0; line-height:0;\">\n              &nbsp;\n            </td>\n          </tr>\n\n          <!-- Content -->\n          <tr>\n            <td style=\"padding:42px 40px 40px 40px;\">\n\n              <!-- Greeting -->\n              <p style=\"margin:0 0 22px 0; font-size:16px; line-height:1.6; font-weight:600; color:#0f172a;\">\n                Hi {{ $json.name || 'there' }},\n              </p>\n\n              <!-- Intro -->\n              <p style=\"margin:0 0 20px 0; font-size:15px; line-height:1.75; color:#334155;\">\n                Thanks for taking the time to submit your project inquiry. We’ve reviewed the information you provided and are looking forward to learning more about what you’re trying to accomplish.\n              </p>\n\n              <p style=\"margin:0 0 28px 0; font-size:15px; line-height:1.75; color:#334155;\">\n                Before we can properly evaluate the scope and determine the right solution for your project, we still need a few additional details.\n              </p>\n\n              <!-- Required Details Card -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#f1f5f9; border:1px solid #e2e8f0; border-left:4px solid #2563eb; border-radius:8px; margin-bottom:28px;\">\n                <tr>\n                  <td style=\"padding:24px 22px 22px 20px;\">\n\n                    <p style=\"margin:0 0 16px 0; font-size:12px; line-height:1.4; font-weight:700; text-transform:uppercase; letter-spacing:0.8px; color:#475569;\">\n                      Information Still Needed\n                    </p>\n\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                      {{\n                        ($json.missingFields || []).map(field => `\n                          <tr>\n                            <td valign=\"top\" style=\"width:24px; padding:6px 8px 6px 0; font-size:14px; line-height:1.5; color:#2563eb; font-weight:700;\">\n                              &bull;\n                            </td>\n                            <td style=\"padding:6px 0; font-size:14px; line-height:1.6; color:#334155;\">\n                              <strong>${field}</strong>\n                            </td>\n                          </tr>\n                        `).join('')\n                      }}\n                    </table>\n\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Response Instruction -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; margin-bottom:30px;\">\n                <tr>\n                  <td style=\"padding:20px 22px;\">\n                    <p style=\"margin:0 0 7px 0; font-size:13px; font-weight:700; color:#0f172a;\">\n                      What to do next\n                    </p>\n\n                    <p style=\"margin:0; font-size:14px; line-height:1.7; color:#475569;\">\n                      Simply <strong style=\"color:#0f172a;\">reply directly to this email</strong> with the missing details. Once we receive them, we can continue evaluating your inquiry and determine the appropriate next steps.\n                    </p>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Closing -->\n              <p style=\"margin:0 0 30px 0; font-size:15px; line-height:1.75; color:#475569;\">\n                We appreciate your interest in working with us and look forward to hearing from you.\n              </p>\n\n              <!-- Divider -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin-bottom:26px;\">\n                <tr>\n                  <td style=\"border-top:1px solid #e2e8f0; font-size:0; line-height:0;\">\n                    &nbsp;\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Signature -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                <tr>\n                  <td>\n                    <p style=\"margin:0 0 7px 0; font-size:14px; line-height:1.5; color:#64748b;\">\n                      Best regards,\n                    </p>\n\n                    <p style=\"margin:0 0 3px 0; font-size:16px; line-height:1.4; font-weight:700; color:#0f172a;\">\n                      Shaban Alam\n                    </p>\n\n                    <p style=\"margin:0 0 3px 0; font-size:13px; line-height:1.5; color:#64748b;\">\n                      Founder &amp; Principal Automation Architect\n                    </p>\n\n                    <p style=\"margin:0; font-size:13px; line-height:1.5; font-weight:700; color:#2563eb;\">\n                      Hashnab Automation\n                    </p>\n                  </td>\n                </tr>\n              </table>\n\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"background-color:#f8fafc; padding:19px 35px; border-top:1px solid #e2e8f0; text-align:center;\">\n              <p style=\"margin:0; font-size:11px; line-height:1.5; color:#94a3b8; letter-spacing:0.2px;\">\n                This inquiry response is automatically generated by Hashnab Automation.\n              </p>\n            </td>\n          </tr>\n\n        </table>\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>",
