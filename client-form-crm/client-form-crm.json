    {
      "parameters": {
        "jsCode": "const results = [];\n\nfunction cleanString(value) {\n  if (value === null || value === undefined) return '';\n  return String(value).trim();\n}\n\nfunction parseAmount(raw, inheritedUnit = '') {\n  const num = Number(String(raw).replace(/,/g, ''));\n  if (!Number.isFinite(num)) return 0;\n  const unit = String(inheritedUnit || '').toLowerCase();\n  if (unit === 'k') return Math.round(num * 1_000);\n  if (unit === 'm') return Math.round(num * 1_000_000);\n  return Math.round(num);\n}\n\nfunction parseBudget(value) {\n  const text = cleanString(value).toLowerCase();\n  if (!text) return { min: 0, max: 0, value: 0 };\n\n  // Handles ranges such as 5k-10k, 5,000 - 10,000, or 5k to 10k.\n  const range = text.match(/[$€£₹]?\\s*([\\d,.]+)\\s*([km]?)\\s*(?:-|–|—|to)\\s*[$€£₹]?\\s*([\\d,.]+)\\s*([km]?)/i);\n  if (range) {\n    const firstUnit = range[2] || '';\n    const secondUnit = range[4] || firstUnit;\n    const min = parseAmount(range[1], firstUnit);\n    const max = parseAmount(range[3], secondUnit);\n    return { min: Math.min(min, max), max: Math.max(min, max), value: Math.min(min, max) };\n  }\n\n  const single = text.match(/([\\d,.]+)\\s*([km]?)/i);\n  if (!single) return { min: 0, max: 0, value: 0 };\n\n  const amount = parseAmount(single[1], single[2]);\n\n  // A ceiling such as \"under 5k\" should not qualify as a 5k+ high-budget lead.\n  if (/\\b(under|below|less than|up to|maximum|max)\\b/i.test(text)) {\n    return { min: 0, max: amount, value: 0 };\n  }\n\n  // A floor such as \"5k+\" qualifies at the stated threshold.\n  return { min: amount, max: amount, value: amount };\n}\n\nfunction validIsoDate(value) {\n  const text = cleanString(value);\n  if (!text) return null;\n  const match = text.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n  if (!match) return null;\n  const year = Number(match[1]);\n  const month = Number(match[2]);\n  const day = Number(match[3]);\n  const date = new Date(Date.UTC(year, month - 1, day));\n  if (\n    date.getUTCFullYear() !== year ||\n    date.getUTCMonth() !== month - 1 ||\n    date.getUTCDate() !== day\n  ) return null;\n  return text;\n}\n\nfor (const item of $input.all()) {\n  const name = cleanString(item.json.name);\n  const email = cleanString(item.json.email).toLowerCase();\n  const inquiryDetails = cleanString(item.json.inquiryDetails);\n  const budgetRange = cleanString(item.json.budgetRange);\n  const moveInDate = validIsoDate(item.json.moveInDate);\n  const source = cleanString(item.json.source) || 'unknown';\n\n  const emailValid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n\n  const missingFields = [];\n  if (!name) missingFields.push('Name');\n  if (!email) missingFields.push('Email');\n  else if (!emailValid) missingFields.push('Valid Email');\n  if (!inquiryDetails || inquiryDetails.length < 10) missingFields.push('Inquiry Details');\n  if (!budgetRange) missingFields.push('Budget Range');\n  if (!moveInDate) missingFields.push('Move-in Date');\n\n  const budget = parseBudget(budgetRange);\n  let leadPriority = 'Low Budget';\n  if (missingFields.length > 0) {\n    leadPriority = 'Missing Info';\n  } else if (budget.min >= 5000) {\n    leadPriority = 'High Budget';\n  }\n\n  results.push({\n    json: {\n      name,\n      email,\n      emailValid,\n      inquiryDetails,\n      budgetRange,\n      budgetMin: budget.min,\n      budgetMax: budget.max,\n      budgetValue: budget.value,\n      moveInDate,\n      source,\n      leadPriority,\n      missingFields,\n      qualifiedAt: new Date().toISOString()\n    }\n  });\n}\n\nreturn results;"
      },
