    {
      "parameters": {
        "sendTo": "youremail@gmail.com",
        "subject": "Thanks for your project inquiry",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Project Inquiry Update</title>\n</head>\n\n<body style=\"margin:0; padding:0; background-color:#f4f6f8; font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; color:#334155; -webkit-font-smoothing:antialiased;\">\n\n  <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#f4f6f8; padding:40px 20px;\">\n    <tr>\n      <td align=\"center\">\n\n        <!-- Main Container -->\n        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:620px; background-color:#ffffff; border-radius:12px; overflow:hidden; border:1px solid #e2e8f0; box-shadow:0 8px 24px rgba(15,23,42,0.06);\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background-color:#17212b; padding:28px 42px;\">\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                <tr>\n                  <td>\n                    <div style=\"font-size:12px; font-weight:700; letter-spacing:1.6px; color:#94a3b8; text-transform:uppercase; margin-bottom:7px;\">\n                      Client Inquiry\n                    </div>\n                    <div style=\"font-size:19px; line-height:1.3; font-weight:700; letter-spacing:0.4px; color:#ffffff;\">\n                      HASHNAB AUTOMATION\n                    </div>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Accent Bar -->\n          <tr>\n            <td style=\"height:4px; background-color:#3182ce; font-size:0; line-height:0;\">\n              &nbsp;\n            </td>\n          </tr>\n\n          <!-- Content -->\n          <tr>\n            <td style=\"padding:42px;\">\n\n              <!-- Greeting -->\n              <p style=\"margin:0 0 22px 0; font-size:16px; line-height:1.6; color:#17212b;\">\n                Hi {{ $json.name || 'there' }},\n              </p>\n\n              <!-- Intro -->\n              <p style=\"margin:0 0 20px 0; font-size:15px; line-height:1.75; color:#475569;\">\n                Thank you for reaching out and sharing the details of your project. We genuinely appreciate the opportunity to learn more about what you're looking to build.\n              </p>\n\n              <!-- Qualification Message -->\n              <p style=\"margin:0 0 28px 0; font-size:15px; line-height:1.75; color:#475569;\">\n                After reviewing your submission and estimated budget, it looks like the project currently falls below our minimum engagement threshold for custom development. Our targeted automation builds typically begin at\n                <strong style=\"color:#17212b;\">$5,000</strong>.\n              </p>\n\n              <!-- Budget Summary Card -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin-bottom:28px; background-color:#f8fafc; border:1px solid #e2e8f0; border-radius:8px;\">\n                <tr>\n                  <td style=\"padding:20px 22px;\">\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                      <tr>\n                        <td style=\"font-size:12px; font-weight:700; letter-spacing:0.7px; text-transform:uppercase; color:#64748b; padding-bottom:7px;\">\n                          Submitted Budget\n                        </td>\n                      </tr>\n                      <tr>\n                        <td style=\"font-size:18px; line-height:1.4; font-weight:700; color:#17212b;\">\n                          {{ $json.budgetRange || 'Not specified' }}\n                        </td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Recommendation -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#f7fafc; border:1px solid #dbeafe; border-left:4px solid #3182ce; border-radius:7px; margin-bottom:28px;\">\n                <tr>\n                  <td style=\"padding:22px 22px 22px 20px;\">\n\n                    <div style=\"font-size:12px; line-height:1.4; font-weight:700; color:#2b6cb0; text-transform:uppercase; letter-spacing:0.8px; margin-bottom:9px;\">\n                      Our Recommendation\n                    </div>\n\n                    <p style=\"margin:0; font-size:14px; line-height:1.7; color:#334155;\">\n                      Because we want to point you in the right direction, we recommend exploring platforms such as <strong>Upwork</strong> or reputable pre-built automation template marketplaces. These can be excellent options for getting a project launched within a smaller initial budget.\n                    </p>\n\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Closing -->\n              <p style=\"margin:0 0 30px 0; font-size:15px; line-height:1.75; color:#475569;\">\n                We appreciate you considering Hashnab Automation and wish you the very best with your project. We hope our paths cross again as your automation needs grow.\n              </p>\n\n              <!-- Divider -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin-bottom:26px;\">\n                <tr>\n                  <td style=\"border-top:1px solid #e2e8f0; font-size:0; line-height:0;\">\n                    &nbsp;\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Signature -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                <tr>\n                  <td>\n                    <p style=\"margin:0 0 7px 0; font-size:14px; line-height:1.5; color:#64748b;\">\n                      Warm regards,\n                    </p>\n\n                    <p style=\"margin:0 0 3px 0; font-size:16px; line-height:1.4; font-weight:700; color:#17212b;\">\n                      Shaban Alam\n                    </p>\n\n                    <p style=\"margin:0 0 3px 0; font-size:13px; line-height:1.5; color:#718096;\">\n                      Founder &amp; Principal Automation Architect\n                    </p>\n\n                    <p style=\"margin:0; font-size:13px; line-height:1.5; font-weight:700; color:#3182ce;\">\n                      Hashnab Automation\n                    </p>\n                  </td>\n                </tr>\n              </table>\n\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"background-color:#f8fafc; padding:19px 42px; border-top:1px solid #edf2f7; text-align:center;\">\n              <p style=\"margin:0; font-size:11px; line-height:1.5; color:#a0aec0; letter-spacing:0.2px;\">\n                This is an automated operational transmission from Hashnab Automation.\n              </p>\n            </td>\n          </tr>\n\n        </table>\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>\n",
