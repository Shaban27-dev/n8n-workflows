      "parameters": {
        "sendTo": "youremail@gmail.com",
        "subject": "=🔥 High-Value Lead Captured | {{ $json.name }} | {{ $json.budgetRange }}",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>High-Value Lead Briefing</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#f8fafc;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#334155;-webkit-font-smoothing:antialiased;\">\n  <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#f8fafc;padding:30px 15px;\">\n    <tr>\n      <td align=\"center\">\n        <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:650px;background-color:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e2e8f0;\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background-color:#4f46e5;background-image:linear-gradient(135deg,#4f46e5 0%,#3730a3 100%);padding:28px 35px;text-align:left;\">\n              <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                <tr>\n                  <td>\n                    <span style=\"display:inline-block;background-color:rgba(255,255,255,0.18);color:#ffffff;font-size:11px;font-weight:700;letter-spacing:1.5px;padding:5px 11px;border-radius:50px;text-transform:uppercase;\">Priority 1</span>\n                    <h1 style=\"color:#ffffff;margin:12px 0 0 0;font-size:23px;line-height:1.25;font-weight:700;letter-spacing:-0.5px;\">🔥 New High-Value Lead Captured</h1>\n                    <p style=\"color:#e0e7ff;margin:8px 0 0 0;font-size:13px;line-height:1.5;\">A lead has cleared the high-budget qualification threshold and requires prompt follow-up.</p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Main content -->\n          <tr>\n            <td style=\"padding:35px;\">\n\n              <h2 style=\"margin:0 0 14px 0;font-size:13px;line-height:1.4;text-transform:uppercase;letter-spacing:0.8px;color:#64748b;font-weight:700;\">Prospect Overview</h2>\n\n              <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#f1f5f9;border:1px solid #e2e8f0;border-radius:8px;margin-bottom:30px;\">\n                <tr>\n                  <td style=\"padding:18px 20px 10px 20px;font-size:14px;color:#475569;font-weight:600;width:35%;\">Prospect Name:</td>\n                  <td style=\"padding:18px 20px 10px 10px;font-size:14px;color:#0f172a;font-weight:600;\">{{ $json.name }}</td>\n                </tr>\n                <tr>\n                  <td style=\"padding:8px 20px;font-size:14px;color:#475569;font-weight:600;\">Email Address:</td>\n                  <td style=\"padding:8px 20px 8px 10px;font-size:14px;color:#4f46e5;font-weight:600;word-break:break-word;\">\n                    <a href=\"mailto:{{ $json.email }}\" style=\"color:#4f46e5;text-decoration:none;\">{{ $json.email }}</a>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:8px 20px;font-size:14px;color:#475569;font-weight:600;\">Stated Budget:</td>\n                  <td style=\"padding:8px 20px 8px 10px;font-size:14px;color:#15803d;font-weight:700;\">💰 {{ $json.budgetRange }}</td>\n                </tr>\n                <tr>\n                  <td style=\"padding:8px 20px;font-size:14px;color:#475569;font-weight:600;\">Qualification:</td>\n                  <td style=\"padding:8px 20px 8px 10px;font-size:14px;color:#15803d;font-weight:700;\">High Budget · ${{ $json.budgetMin }}+ minimum</td>\n                </tr>\n                <tr>\n                  <td style=\"padding:8px 20px 18px 20px;font-size:14px;color:#475569;font-weight:600;\">Start Date:</td>\n                  <td style=\"padding:8px 20px 18px 10px;font-size:14px;color:#0f172a;\">📅 {{ $json.moveInDate }}</td>\n                </tr>\n              </table>\n\n              <h2 style=\"margin:0 0 12px 0;font-size:13px;line-height:1.4;text-transform:uppercase;letter-spacing:0.8px;color:#64748b;font-weight:700;\">Project Scope Summary</h2>\n\n              <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-left:4px solid #4f46e5;background-color:#fafafa;border-top:1px solid #f1f5f9;border-right:1px solid #f1f5f9;border-bottom:1px solid #f1f5f9;margin-bottom:30px;\">\n                <tr>\n                  <td style=\"padding:17px 20px;font-size:14px;line-height:1.65;color:#334155;font-style:italic;\">\n                    “{{ $json.inquiryDetails }}”\n                  </td>\n                </tr>\n              </table>\n\n              <h2 style=\"margin:0 0 14px 0;font-size:13px;line-height:1.4;text-transform:uppercase;letter-spacing:0.8px;color:#64748b;font-weight:700;\">Required Next Steps <span style=\"text-transform:none;letter-spacing:0;color:#94a3b8;font-weight:500;\">(SLA: 4 Hours)</span></h2>\n\n              <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border:1px solid #e2e8f0;border-radius:8px;margin-bottom:32px;\">\n                <tr>\n                  <td style=\"padding:17px 20px 7px 20px;font-size:13px;line-height:1.55;color:#475569;\">🟧 <strong style=\"color:#334155;\">Step 1:</strong> Review the complete discovery payload in the CRM.</td>\n                </tr>\n                <tr>\n                  <td style=\"padding:7px 20px;font-size:13px;line-height:1.55;color:#475569;\">🟧 <strong style=\"color:#334155;\">Step 2:</strong> Audit the prospect's company and domain context.</td>\n                </tr>\n                <tr>\n                  <td style=\"padding:7px 20px 17px 20px;font-size:13px;line-height:1.55;color:#475569;\">🟧 <strong style=\"color:#334155;\">Step 3:</strong> Prepare a personalized follow-up and secure the discovery call.</td>\n                </tr>\n              </table>\n\n              <!-- CTA -->\n              <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                <tr>\n                  <td align=\"center\">\n                    <a href=\"{{ $json.crmUrl }}\" target=\"_blank\" style=\"display:inline-block;background-color:#4f46e5;color:#ffffff;font-weight:700;font-size:14px;line-height:1;padding:15px 30px;text-decoration:none;border-radius:7px;letter-spacing:0.4px;text-transform:uppercase;\">Open Record in CRM →</a>\n                  </td>\n                </tr>\n              </table>\n\n              <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin-top:24px;\">\n                <tr>\n                  <td style=\"font-size:12px;line-height:1.5;color:#94a3b8;text-align:center;\">\n                    Lead source: <strong style=\"color:#64748b;\">{{ $json.source }}</strong>\n                  </td>\n                </tr>\n              </table>\n\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"background-color:#f8fafc;padding:20px 35px;text-align:center;border-top:1px solid #e2e8f0;\">\n              <p style=\"margin:0;font-size:11px;line-height:1.5;color:#94a3b8;letter-spacing:0.3px;\">Engineered via Hashnab Automation Systems Infrastructure.</p>\n            </td>\n          </tr>\n\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
