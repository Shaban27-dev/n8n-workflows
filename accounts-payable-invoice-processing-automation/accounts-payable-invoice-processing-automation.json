    {
      "parameters": {
        "text": "={{ $json.results?.[0]?.entities?.[0]?.objects?.[0]?.entities?.[0]?.text || '' }}",
        "attributes": {
          "attributes": [
            {
              "name": "Invoice Number",
              "description": "The supplier/vendor invoice number. Extract exactly as shown on the invoice. Do not infer or fabricate it. Use \"Not Found\" if unavailable.",
              "required": true
            },
            {
              "name": "Vendor Name",
              "description": "The legal/business name of the supplier/vendor issuing the invoice. Distinguish the vendor from the Bill To/customer/recipient information. Use \"Not Found\" if unavailable.",
              "required": true
            },
            {
