      "parameters": {
        "jsCode": "// Deterministic AP duplicate detection.\n// Duplicate key: normalized Vendor Name + Invoice Number.\n// This checks the current AP Invoice Register snapshot and does not perform fraud detection.\nconst invoice = $('Combine AP OCR & Metadata').first().json;\nconst rows = $input.all().map(item => item.json || {});\n\nconst normalize = (value) =>\n  String(value ?? '')\n    .trim()\n    .toLowerCase()\n    .replace(/\\s+/g, ' ');\n\nconst vendorName = String(invoice.output?.['Vendor Name'] ?? '').trim();\nconst invoiceNumber = String(invoice.output?.['Invoice Number'] ?? '').trim();\nconst duplicateKey = `${normalize(vendorName)}::${normalize(invoiceNumber)}`;\n\nconst matchingRows = rows.filter(row =>\n  normalize(row['Vendor Name']) === normalize(vendorName) &&\n  normalize(row['Invoice Number']) === normalize(invoiceNumber)\n);\n\nreturn [{\n  json: {\n    ...invoice,\n    duplicateDetected: matchingRows.length > 0,\n    duplicateKey,\n    duplicateMatchCount: matchingRows.length,\n    duplicateMatch: matchingRows[0] || null\n  }\n}];\n"
      },
