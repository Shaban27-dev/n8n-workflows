{
  "name": "Accounts Payable Invoice Processing Automation",
  "nodes": [
    {
      "parameters": {
        "sendTo": "youremail@gmail.com",
        "subject": "=AP Invoice {{ $('Combine AP OCR & Metadata').item.json.output?.['Invoice Number'] || 'Not Found' }} Processed - Internal Finance Notification",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>AP Invoice Processed</title>\n</head>\n<body style=\"margin:0;padding:0;background:#f4f6f8;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f4f6f8;padding:36px 10px;\">\n    <tr><td align=\"center\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:620px;background:#ffffff;border:1px solid #e1e4e8;border-radius:8px;overflow:hidden;\">\n        <tr>\n          <td style=\"background:#1e293b;padding:30px 28px;text-align:center;\">\n            <div style=\"display:inline-block;background:#10b981;color:#ffffff;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:5px 12px;border-radius:20px;\">Accounts Payable</div>\n            <h1 style=\"margin:12px 0 0;color:#ffffff;font-size:22px;font-weight:600;\">Invoice Processed Successfully</h1>\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding:28px;\">\n            <p style=\"margin:0 0 14px;color:#334155;font-size:15px;line-height:24px;\">Hi Finance Team,</p>\n            <p style=\"margin:0 0 22px;color:#475569;font-size:15px;line-height:24px;\">\n              This AP invoice passed the configured deterministic intake validation rules and was written to the AP Invoice Register.\n            </p>\n\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;font-size:14px;\">\n              <tr>\n                <td style=\"padding:10px 14px;color:#64748b;border-bottom:1px solid #edf2f7;font-weight:500;\">Invoice Number</td>\n                <td style=\"padding:10px 14px;color:#0f172a;border-bottom:1px solid #edf2f7;text-align:right;font-weight:700;\">{{ $('Combine AP OCR & Metadata').item.json.output?.['Invoice Number'] || 'Not Found' }}</td>\n              </tr>\n              <tr>\n                <td style=\"padding:10px 14px;color:#64748b;border-bottom:1px solid #edf2f7;font-weight:500;\">Vendor</td>\n                <td style=\"padding:10px 14px;color:#0f172a;border-bottom:1px solid #edf2f7;text-align:right;font-weight:600;\">{{ $('Combine AP OCR & Metadata').item.json.output?.['Vendor Name'] || 'Not Found' }}</td>\n              </tr>\n              <tr>\n                <td style=\"padding:10px 14px;color:#64748b;border-bottom:1px solid #edf2f7;font-weight:500;\">Invoice Date</td>\n                <td style=\"padding:10px 14px;color:#0f172a;border-bottom:1px solid #edf2f7;text-align:right;\">{{ $('Combine AP OCR & Metadata').item.json.output?.['Invoice Date'] || 'Not Found' }}</td>\n              </tr>\n              <tr>\n                <td style=\"padding:10px 14px;color:#64748b;border-bottom:1px solid #edf2f7;font-weight:500;\">Due Date</td>\n                <td style=\"padding:10px 14px;color:#0f172a;border-bottom:1px solid #edf2f7;text-align:right;\">{{ $('Combine AP OCR & Metadata').item.json.output?.['Due Date'] || 'Not Found' }}</td>\n              </tr>\n              <tr>\n                <td style=\"padding:10px 14px;color:#64748b;border-bottom:1px solid #edf2f7;font-weight:500;\">Total Amount</td>\n                <td style=\"padding:10px 14px;color:#4f46e5;border-bottom:1px solid #edf2f7;text-align:right;font-weight:700;font-size:16px;\">{{ $('Combine AP OCR & Metadata').item.json.output?.['Total Amount'] || 'Not Found' }}</td>\n              </tr>\n              <tr>\n                <td style=\"padding:10px 14px;color:#64748b;font-weight:500;\">Processing Status</td>\n                <td style=\"padding:10px 14px;color:#059669;text-align:right;font-weight:700;\">Valid - Processed</td>\n              </tr>\n            </table>\n\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-top:24px;\">\n              <tr><td align=\"center\">\n                <a href=\"{{ $('Combine AP OCR & Metadata').item.json.webViewLink }}\" target=\"_blank\" style=\"display:inline-block;background:#10b981;color:#ffffff;text-decoration:none;font-size:14px;font-weight:600;padding:12px 24px;border-radius:6px;margin:4px 6px;\">Open Archived Invoice</a>\n                <a href=\"https://docs.google.com/spreadsheets/d/your-spreadsheet-folder-id/edit#gid=0\" target=\"_blank\" style=\"display:inline-block;background:#334155;color:#ffffff;text-decoration:none;font-size:14px;font-weight:600;padding:12px 24px;border-radius:6px;margin:4px 6px;\">Open AP Invoice Register</a>\n              </td></tr>\n            </table>\n\n            <p style=\"margin:24px 0 0;color:#64748b;font-size:13px;line-height:20px;\">\n              This notification confirms AP intake, extraction, validation, archival, and record creation. It does not represent payment execution or accounting approval.\n            </p>\n          </td>\n        </tr>\n        <tr>\n          <td style=\"background:#f8fafc;border-top:1px solid #e2e8f0;padding:18px;text-align:center;color:#94a3b8;font-size:11px;line-height:18px;\">\n            Automated internal notification generated by the n8n Accounts Payable invoice-processing workflow.\n          </td>\n        </tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "ab6b8925-b810-453f-8db9-0f0f49db7e8d",
      "name": "Notify Finance Team - AP Invoice Processed",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        2256,
