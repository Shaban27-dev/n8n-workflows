    {
      "parameters": {
        "sendTo": "youremail@gmail.com",
        "subject": "=AP Review Required: Invoice Exception ({{ $('Combine AP OCR & Metadata').item.json.output?.['Vendor Name'] || 'Unknown Vendor' }} - {{ $('Combine AP OCR & Metadata').item.json.output?.['Invoice Number'] || 'Unknown Invoice' }})",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>AP Invoice Exception</title>\n</head>\n<body style=\"margin:0;padding:0;background:#f4f6f8;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f4f6f8;padding:30px 0;\">\n    <tr><td align=\"center\">\n      <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;background:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #e1e4e8;border-top:4px solid #e74c3c;\">\n        <tr>\n          <td style=\"padding:32px 36px 20px;\">\n            <span style=\"display:inline-block;background:#fce8e6;color:#c53929;padding:6px 12px;font-size:12px;font-weight:700;text-transform:uppercase;border-radius:4px;letter-spacing:.5px;\">⚠️ AP Review Required</span>\n            <h2 style=\"margin:14px 0 10px;color:#1a202c;font-size:22px;\">Invoice Processing Exception</h2>\n            <p style=\"margin:0;color:#718096;font-size:15px;line-height:1.6;\">\n              The invoice was archived, but it did not pass the configured first-line AP validation or duplicate check. It has been routed to the exception log for manual review.\n            </p>\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding:10px 36px 22px;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f7fafc;border:1px solid #e2e8f0;border-radius:6px;font-size:14px;\">\n              <tr>\n                <td width=\"38%\" style=\"padding:11px 13px;font-weight:600;color:#718096;border-bottom:1px solid #edf2f7;\">Vendor</td>\n                <td style=\"padding:11px 13px;color:#1a202c;border-bottom:1px solid #edf2f7;\">{{ $('Log AP Invoice Exception').item.json['Vendor Name'] || 'Not Found' }}</td>\n              </tr>\n              <tr>\n                <td style=\"padding:11px 13px;font-weight:600;color:#718096;border-bottom:1px solid #edf2f7;\">Invoice Number</td>\n                <td style=\"padding:11px 13px;color:#1a202c;border-bottom:1px solid #edf2f7;\">{{ $('Log AP Invoice Exception').item.json['Invoice Number'] || 'Not Found' }}</td>\n              </tr>\n              <tr>\n                <td style=\"padding:11px 13px;font-weight:600;color:#718096;border-bottom:1px solid #edf2f7;\">Extracted Amount</td>\n                <td style=\"padding:11px 13px;font-weight:700;color:#1a202c;border-bottom:1px solid #edf2f7;\">{{ $('Log AP Invoice Exception').item.json['Extracted Amount'] || 'Not Found' }}</td>\n              </tr>\n              <tr>\n                <td style=\"padding:11px 13px;font-weight:600;color:#718096;border-bottom:1px solid #edf2f7;\">Failure Reason</td>\n                <td style=\"padding:11px 13px;color:#c53929;font-weight:700;border-bottom:1px solid #edf2f7;\">{{ $('Log AP Invoice Exception').item.json['Failure Reason'] }}</td>\n              </tr>\n              <tr>\n                <td style=\"padding:11px 13px;font-weight:600;color:#718096;\">Review Status</td>\n                <td style=\"padding:11px 13px;color:#dd6b20;font-weight:700;\">● Pending Review</td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n        <tr>\n          <td align=\"center\" style=\"padding:8px 36px 36px;\">\n            <a href=\"{{ $('Combine AP OCR & Metadata').item.json.webViewLink }}\" target=\"_blank\" style=\"display:inline-block;background:#e74c3c;color:#ffffff;text-decoration:none;font-size:14px;font-weight:600;padding:14px 26px;border-radius:5px;\">Open Archived Invoice for Review</a>\n            <p style=\"margin:18px 0 0;color:#718096;font-size:13px;line-height:20px;\">\n              Next action: review the invoice and the exception reason in the AP Exception Log. Do not treat this alert as payment or accounting approval.\n            </p>\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding:18px 36px;background:#edf2f7;color:#a0aec0;text-align:center;font-size:11px;line-height:18px;\">\n            Automated internal finance notification generated by the n8n Accounts Payable invoice-processing workflow.\n          </td>\n        </tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>",
        "options": {
          "appendAttribution": false
        }
      },
