    {
      "parameters": {
        "jsCode": "// 1. Fetch metadata directly from the Classify File node\n// (Bypasses Google Drive Move nodes which strip custom n8n properties)\nlet originalData = {};\ntry {\n  originalData = $('Classify File').item.json;\n} catch (e) {\n  try {\n    originalData = $('Classify File').first().json;\n  } catch (err) {\n    originalData = $input.item.json;\n  }\n}\n\nconst fileName = originalData.name || $input.item.json.name || 'Unknown File';\nconst category = originalData.cleanCategory || '';\nconst mime = originalData.shortcutDetails?.targetMimeType || originalData.mimeType || $input.item.json.mimeType || '';\n\n// 2. Determine Action Taken based on which execution branch ran\nlet actionTaken = 'Skipped - Unsupported File Type';\n\ntry { if ($('Move PNG File').item) actionTaken = 'Moved to Images Folder'; } catch (e) {}\ntry { if ($('Move PDF File').item) actionTaken = 'Moved to PDFs Folder'; } catch (e) {}\ntry { if ($('Move Document File').item) actionTaken = 'Moved to Documents Folder'; } catch (e) {}\ntry { if ($('Move CSV file').item) actionTaken = 'Moved to Spreadsheets Folder'; } catch (e) {}\n\n// Fallback if branch execution check is bypassed\nif (actionTaken === 'Skipped - Unsupported File Type' && category && category !== 'unsupported') {\n  const statusMap = {\n    image: 'Moved to Images Folder',\n    pdf: 'Moved to PDFs Folder',\n    document: 'Moved to Documents Folder',\n    spreadsheet: 'Moved to Spreadsheets Folder'\n  };\n  if (statusMap[category]) actionTaken = statusMap[category];\n}\n\n// 3. Resolve File Extension safely\nlet fileExt = originalData.cleanExtension;\n\n// Fallback resolution if cleanExtension is missing or 'none'\nif (!fileExt || fileExt === 'none') {\n  if (fileName.includes('.')) {\n    fileExt = fileName.split('.').pop().toLowerCase();\n  } else if (category === 'spreadsheet' || mime.includes('spreadsheet')) {\n    fileExt = 'gsheet';\n  } else if (category === 'document' || mime.includes('document')) {\n    fileExt = 'gdoc';\n  } else if (category === 'image' || mime.includes('image')) {\n    fileExt = 'png';\n  } else if (category === 'pdf' || mime.includes('pdf')) {\n    fileExt = 'pdf';\n  } else if (actionTaken.includes('Spreadsheets')) {\n    fileExt = 'gsheet';\n  } else if (actionTaken.includes('Images')) {\n    fileExt = 'png';\n  } else if (actionTaken.includes('PDFs')) {\n    fileExt = 'pdf';\n  } else if (actionTaken.includes('Documents')) {\n    fileExt = 'gdoc';\n  } else {\n    fileExt = 'none';\n  }\n}\n\n// 4. Generate clean IST Timestamp (YYYY-MM-DD HH:mm:ss)\nconst now = new Date();\nconst timestamp = new Intl.DateTimeFormat('sv-SE', {\n  timeZone: 'Asia/Kolkata',\n  year: 'numeric',\n  month: '2-digit',\n  day: '2-digit',\n  hour: '2-digit',\n  minute: '2-digit',\n  second: '2-digit'\n}).format(now);\n\n// 5. Output formatted log object\nreturn [{\n  json: {\n    Timestamp: timestamp,\n    FileName: fileName,\n    FileExtension: fileExt,\n    Status: actionTaken\n  }\n}];"
      },
