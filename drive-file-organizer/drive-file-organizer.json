    {
      "parameters": {
        "jsCode": "const file = $input.item.json;\nconst fileName = file.name || 'Unknown File';\n\n// 1. Resolve effective MIME type (checks shortcut target first)\nconst mimeType = file.shortcutDetails?.targetMimeType || file.mimeType || '';\n\n// 2. Extract file extension from name if present\nlet ext = file.fileExtension;\nif (!ext && fileName.includes('.')) {\n  ext = fileName.split('.').pop().toLowerCase();\n}\n\n// 3. Fallback: Infer extension from MIME type for native Google files or shortcuts\nif (!ext) {\n  if (mimeType.includes('spreadsheet')) ext = 'gsheet';\n  else if (mimeType.includes('document')) ext = 'gdoc';\n  else if (mimeType.includes('presentation')) ext = 'gslides';\n  else if (mimeType.includes('pdf')) ext = 'pdf';\n  else if (mimeType.includes('image')) ext = 'png';\n}\n\n// 4. Categorize file based on extension and MIME type\nlet category = 'unsupported';\n\nif (/^(png|jpe?g|webp|gif|svg)$/i.test(ext) || mimeType.includes('image')) {\n  category = 'image';\n} else if (ext === 'pdf' || mimeType.includes('pdf')) {\n  category = 'pdf';\n} else if (/^(docx?|txt|rtf|gdoc)$/i.test(ext) || mimeType.includes('document')) {\n  category = 'document';\n} else if (/^(csv|xlsx?|ods|gsheet)$/i.test(ext) || mimeType.includes('spreadsheet')) {\n  category = 'spreadsheet';\n}\n\n// 5. Output unified properties\nreturn [{\n  json: {\n    ...file,\n    cleanCategory: category,\n    cleanExtension: ext || 'none'\n  }\n}];"
      },
